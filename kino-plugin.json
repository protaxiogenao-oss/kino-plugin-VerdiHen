{
  "id": "verhentai",
  "name": "VerHentai",
  "version": "1.0.3",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Hentai en español de verhentai.com. Series con episodios, HLS (octopus + master-lengs), subtítulos Español (genérico) por defecto o por ajuste.",
  "author": "Hotaru Yume",
  "creator": "hotaruyume",
  "homepage": "https://verhentai.com",
  "hosts": [
    "verhentai.com",
    "*.verhentai.com",
    "www.verhentai.com",
    "img.hentaihaven.xxx",
    "*.hentaihaven.xxx",
    "coverlanyvd.org",
    "*.coverlanyvd.org",
    "octopusmanifest.org",
    "*.octopusmanifest.org",
    "anpustream.com",
    "*.anpustream.com",
    "fdsk2s.anpustream.com",
    "cdn.havenclick.com",
    "master-lengs.org",
    "*.master-lengs.org",
    "es.master-lengs.org",
    "esp-rrr.top",
    "*.esp-rrr.top"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "anime",
    "series",
    "movies"
  ],
  "color": "#E91E63",
  "icon": "icon.png",
  "theme": {
    "accent": "#E91E63",
    "onAccent": "#FFFFFF",
    "background": "#0D0D0D",
    "surface": "#1A1A1A",
    "highlight": "#F06292"
  },
  "settings": [
    {
      "key": "preferSub",
      "label": "Subtítulo preferido",
      "type": "select",
      "default": "es",
      "options": [
        { "value": "es", "label": "Español (genérico)" },
        { "value": "en", "label": "Inglés" },
        { "value": "off", "label": "Ninguno / solo los del vídeo" }
      ]
    }
  ]
}
